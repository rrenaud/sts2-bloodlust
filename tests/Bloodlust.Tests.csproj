<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2/data_sts2_linuxbsd_x86_64</Sts2DataDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bloodlust.csproj" />
    <Reference Include="$(Sts2DataDir)/*.dll" Exclude="$(Sts2DataDir)/System*.dll;$(Sts2DataDir)/Microsoft*.dll;$(Sts2DataDir)/mscorlib.dll;$(Sts2DataDir)/netstandard.dll;$(Sts2DataDir)/WindowsBase.dll" />
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.7" />
  </ItemGroup>
</Project>
